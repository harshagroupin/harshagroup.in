{
  "redirects": [
    { "source": "/home/", "destination": "/", "permanent": true },
    { "source": "/about-us/", "destination": "/about", "permanent": true },
    { "source": "/contact/", "destination": "/contact", "permanent": true },
    { "source": "/apartment_list/indirapuram/", "destination": "/projects/indirapuram", "permanent": true },
    { "source": "/apartment_list/greater-noida/", "destination": "/projects/greater-noida", "permanent": true },
    { "source": "/apartment_list/karnal/", "destination": "/projects/karnal", "permanent": true },
    { "source": "/faq/", "destination": "/", "permanent": true },
    { "source": "/testimonial/:path*", "destination": "/about", "permanent": true },
    { "source": "/privacy-policy-2/", "destination": "/terms-and-conditions", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
